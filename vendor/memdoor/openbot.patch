+func TestOpenBotTeamRoleRetainsWorkflowPromptAndTreatsOverrideAsText(t *testing.T) {
+	role := &templates.YamlTaskDefinition{Type: "agent", Prompt: "Write report {{.Name}}.", Model: "old"}
+	command := &templates.YamlTaskDefinition{Type: "command", Prompt: "Unchanged"}
+	wf := workflow.Workflow{
