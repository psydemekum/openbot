+func TestOpenBotTeamBoundsAnswersAndChecksArtifacts(t *testing.T) {
+	cwd := t.TempDir()
+	dir := filepath.Join(cwd, openBotReplyDir("test"))
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	reply := filepath.Join(dir, "answer.md")
+	if err := os.WriteFile(filepath.Join(cwd, "report.txt"), []byte("42"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	writeAnswer := func(body, file string) {
+		t.Helper()
+		if err := os.WriteFile(reply, []byte(body+"\n"+openBotArtifactHeader("test")+"\n"+file+"\n-->"), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	writeAnswer(strings.Repeat("x", 100_000), "report.txt")
+	if answer, err := openBotTeamAnswer(cwd, "test"); answer != "" || err == nil || !strings.Contains(err.Error(), "100000") {
+		t.Fatalf("links above the chat limit returned %d bytes, err %v", len(answer), err)
+	}
+	if err := os.WriteFile(reply, []byte(openBotArtifactHeader("test")+"\nreport.txt\n-->"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if got, err := openBotTeamAnswer(cwd, "test"); err != nil || got != "`"+filepath.ToSlash(filepath.Join(cwd, "report.txt"))+"`" {
+		t.Fatalf("file-only reply %q, err %v", got, err)
+	}
+	for _, name := range []string{"../secret.txt", ".git/config", ".memdoor/runs/outline.md", "missing.csv", "."} {
+		writeAnswer("answer", name)
+		if answer, err := openBotTeamAnswer(cwd, "test"); err == nil || answer != "" {
+			t.Errorf("returned invalid artifact %q", name)
+		}
+	}
