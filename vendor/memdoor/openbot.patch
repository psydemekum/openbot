+package gateway
+
+import (
+	"context"
+	"testing"
+
+	"memdoor/gateway/providers"
+	"memdoor/internal/testenv"
+	"memdoor/pkg/decision"
+)
+
+func TestOpenBotDecisionModelSelection(t *testing.T) {
+	testenv.SetHome(t, t.TempDir())
+	t.Setenv(envSystemOneURL, "http://127.0.0.1:1")
+	t.Setenv(envSystemOneKey, "test-system-one-key")
+	t.Setenv(envTypeSafeKey, "")
+	t.Setenv("OPEN_ROUTER_API_KEY", "")
+	t.Setenv("OPENROUTER_API_KEY", "")
+	previous := providers.ActiveRemoteEngine()
+	t.Cleanup(func() {
+		if previous == nil {
+			_ = providers.ClearRemoteEngine()
+		} else {
+			_ = providers.SetRemoteEngine(*previous)
+		}
+	})
+	const official = "https://api.openai.com/v1"
+	for _, tt := range []struct {
+		name, model, vendor, endpoint, envBaseURL, key, want string
+	}{
+		{"unset preserves System One", "", providers.VendorOpenAI, official, "", "test-key", "systemone"},
+		{"blank preserves System One", "   ", providers.VendorOpenAI, official, "", "test-key", "systemone"},
+		{"official overrides System One", " gpt-6-luna ", providers.VendorOpenAI, official, "", "test-key", "openai"},
+		{"official base env", "gpt-6-luna", providers.VendorOpenAI, official + "/", official, "test-key", "openai"},
+		{"missing key", "gpt-6-luna", providers.VendorOpenAI, official, "", "", ""},
+		{"blank key", "gpt-6-luna", providers.VendorOpenAI, official, "", "  ", ""},
+		{"no active engine", "gpt-6-luna", "", "", "", "test-key", ""},
+		{"signed-in plan", "gpt-6-luna", providers.VendorChatGPT, official, "", "test-key", ""},
+		{"other vendor", "gpt-6-luna", providers.VendorGoogle, official, "", "test-key", ""},
+		{"custom endpoint", "gpt-6-luna", providers.VendorOpenAI, "https://gateway.example/v1", "", "test-key", ""},
+		{"custom base env", "gpt-6-luna", providers.VendorOpenAI, official, "https://gateway.example/v1", "test-key", ""},
+		{"invalid base env", "gpt-6-luna", providers.VendorOpenAI, official, "/", "test-key", ""},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			t.Setenv("MEMDOOR_OPENBOT_DECISION_MODEL", tt.model)
+			t.Setenv("OPENAI_API_KEY", tt.key)
+			t.Setenv("OPENAI_BASE_URL", tt.envBaseURL)
+			if tt.vendor == "" {
+				_ = providers.ClearRemoteEngine()
+			} else if err := providers.SetRemoteEngine(providers.RemoteEngine{
+				Vendor: tt.vendor, Endpoint: tt.endpoint, Model: "agent-model",
+			}); err != nil {
+				t.Fatal(err)
+			}
+
+			service, err := newDecisionService(func(string) string { return "" })
+			if err != nil {
+				t.Fatal(err)
+			}
+			registered := service.(decision.Providers).Providers()
+			if tt.want != "" {
+				if len(registered) != 1 || registered[0].ID() != tt.want || !service.(decision.Availability).Available("") {
+					t.Fatalf("registered providers %v, want a ready %s", registered, tt.want)
+				}
+				return
+			}
+			if len(registered) != 0 || service.(decision.Availability).Available("") {
+				t.Fatal("invalid opt-in registered a provider or reported availability")
+			}
+			q, err := decision.Boolean("Is the light on?", "", "")
+			if err != nil {
+				t.Fatal(err)
+			}
+			req := decision.Request{State: "The light is on.", Questions: map[string]decision.Question{"on": q}}
+			res := service.Evaluate(context.Background(), req, decision.Options{})
+			if res.Status != decision.StatusUnavailable || res.Reason != decision.ReasonNotConfigured {
+				t.Fatalf("invalid opt-in returned %+v", res)
+			}
+		})
+	}
+}
