 }
+
+func TestOpenBotTeamKeepRestoresTheSelectedNonGitReply(t *testing.T) {
+	repo, err := filepath.Abs("..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := os.ReadFile("team-solve/steps/keep.yaml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var step struct {
+		Command string `yaml:"command"`
+	}
+	if err := yaml.Unmarshal(raw, &step); err != nil {
+		t.Fatal(err)
+	}
+	keep := strings.ReplaceAll(step.Command, "{{.partition}}", "openbot-keep")
+	for _, scenario := range []string{"plain", "unborn", "changed artifact", "missing checkpoint", "interrupted repair"} {
+		t.Run(scenario, func(t *testing.T) {
+			cmd := exec.Command("bash", "-ec", `
+				if [ "$2" = unborn ]; then git init -q; fi
+				w="$1/workflows/team-solve"; r=.memdoor/runs/team-solve-openbot-keep
+				mkdir -p "$r/reply"; touch "$r/start"
+				printf 'original' > report.txt
+				printf 'direct answer\n<!-- openbot-artifacts: openbot-keep\nreport.txt\n-->\n' > "$r/reply/answer.md"
+				echo 0 > "$r/direct-status.txt"
+				bash "$w/snapshot.sh" save "$r" direct
+				echo 'rejected answer' > "$r/reply/answer.md"
+				echo 1 > "$r/final-status.txt"
+				echo '{"pass":false}' > "$r/judge-score.json"
+				echo '{"pass":false}' > "$r/review-score.json"
+				if [ "$2" != 'interrupted repair' ]; then echo repair > "$r/repair.md"; fi
+				case "$2" in
+				'changed artifact') printf 'replaced' > report.txt ;;
+				'missing checkpoint') rm -- "$r/direct.answer.md" ;;
+				esac
+				if sh -c "$3"; then code=0; else code=$?; fi
+				case "$2" in
+				'changed artifact'|'missing checkpoint')
+					test "$code" != 0
+					test ! -e "$r/keep.txt" ;;
+				*)
+					test "$code" = 0
+					grep -q '^put back: the direct attempt' "$r/keep.txt"
+					grep -qx 'direct answer' "$r/reply/answer.md"
+					grep -qx 'report.txt' "$r/reply/answer.md"
+					grep -qx original report.txt ;;
+				esac
+			`, "test", filepath.ToSlash(repo), scenario, keep)
+			cmd.Dir = t.TempDir()
+			cmd.Env = append(os.Environ(), "MEMDOOR_OPENBOT_TEAM=1", "MEMDOOR_OPENBOT_STATE_DIR="+filepath.ToSlash(repo))
+			if out, err := cmd.CombinedOutput(); err != nil {
+				t.Fatalf("keep: %v\n%s", err, out)
+			}
+		})
+	}
+}
