+		t.Fatalf("roles changed unexpectedly: %s, %v, %s", role.Model, wf.Tasks, command.Prompt)
+	}
+	tpl, err := template.New("prompt").Parse(role.Prompt)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got bytes.Buffer
+	if err := tpl.Execute(&got, map[string]string{"Name": "A"}); err != nil {
+		t.Fatal(err)
