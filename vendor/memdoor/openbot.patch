+		t.Run("effort="+effort, func(t *testing.T) {
+			def := &templates.YamlTaskDefinition{Type: "llm"}
+			wf := workflow.Workflow{Defs: map[string]*templates.YamlTaskDefinition{"plan": def}, Tasks: []workflow.Task{{Full: "plan"}}}
+			if err := applyOpenBotTeamRoles(&wf, map[string]openBotTeamRole{"plan": {Model: "gpt-6-sol", Effort: effort}}); err != nil {
+				t.Fatal(err)
+			}
