+package cmd
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestOpenBotGatewayBootstrapsOnItsPrivateListener(t *testing.T) {
+	t.Setenv("MEMDOOR_OPENBOT_TEAM", "1")
+	t.Setenv("MEMDOOR_TELEMETRY_ENABLED", "0")
+	t.Setenv("MEMDOOR_OPENBOT_STATE_DIR", t.TempDir())
+	t.Setenv("MEMDOOR_MODEL", "gpt-6.2-sol")
+	t.Setenv("OPENAI_API_KEY", "sk-local-test-fixture")
+	if runtime.GOOS == "windows" {
+		if git, err := exec.LookPath("git.exe"); err == nil {
+			bin := filepath.Join(filepath.Dir(filepath.Dir(git)), "usr", "bin")
+			t.Setenv("PATH", bin+string(os.PathListSeparator)+os.Getenv("PATH"))
+		}
+	}
+	previousAddr, previousToken, previousWorkspace := gatewayAddr, openBotGatewayToken, workspaceSlug
+	defer func() {
+		gatewayAddr, openBotGatewayToken, workspaceSlug = previousAddr, previousToken, previousWorkspace
+	}()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	g := openBotGateway{ctx: ctx}
+	client, err := g.client()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if client.token == "" || client.workspaceSlug == "" {
+		t.Fatal("gateway did not sign the managed process in to a workspace")
+	}
+	response, err := (&http.Client{Timeout: time.Second}).Get(client.BaseURL + "/api/setup/status")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusNotFound {
+		t.Fatalf("the gateway answered a client without the managed header: %d", response.StatusCode)
+	}
+}
+
+type openBotTestSink struct {
+	output []string
+	ask    string
+}
+
+func (s *openBotTestSink) Text(text string)                        { s.output = append(s.output, text) }
+func (*openBotTestSink) ToolStart(string, string, json.RawMessage) {}
+func (*openBotTestSink) ToolDone(string, string, bool)             {}
+func (s *openBotTestSink) Ask(string, []string, string) string     { return s.ask }
+
+func TestOpenBotTeamReturnsTheFinalResult(t *testing.T) {
+	var actions []string
+	cwd := t.TempDir()
+	write := func(name, data string) {
+		t.Helper()
+		if err := os.MkdirAll(filepath.Dir(name), 0700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(name, []byte(data), 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	write(filepath.Join(cwd, "answer.md"), "stale answer")
+	write(filepath.Join(cwd, openBotReplyDir("previous"), "answer.md"), "previous turn")
+	artifact := filepath.Join(cwd, "reports", "Q4 report.csv")
+	write(artifact, "revenue,42")
+	var partition string
+	post := func(path string, body interface{}, result interface{}) error {
+		actions = append(actions, path)
+		req := body.(map[string]interface{})
+		out := result.(*workflowRunStatus)
+		switch path {
+		case "/api/workflow/run":
+			partition = req["partition"].(string)
+			prompt := req["prompt"].(string)
+			if req["name"] != "team-solve" || req["model"] != "openai:gpt-6.2-sol" || !strings.HasPrefix(prompt, "Analyze Q4.\n") ||
+				!strings.Contains(prompt, ".memdoor/runs/team-solve-"+partition+"/reply/answer.md") {
+				return fmt.Errorf("wrong team request: %v", req)
+			}
+			*out = workflowRunStatus{ID: "team-1", State: "running", Total: 2}
+		case "/api/workflow/status":
+			if req["run_id"] != "team-1" {
+				return errors.New("wrong run")
+			}
+			dir := filepath.Join(cwd, openBotReplyDir(partition))
+			write(filepath.Join(dir, "answer.md"), "Revenue was 42.\n\nIt doubled over Q3.\r\n"+
+				openBotArtifactHeader(partition)+"\r\nreports/Q4 report.csv\r\n-->\r\n")
+			*out = workflowRunStatus{ID: "team-1", Partition: partition, State: "done", Done: 2, Total: 2,
+				Results: []string{".memdoor/runs/team-solve-" + partition + "/outline.md"}}
+		}
+		return nil
+	}
+	sink := &openBotTestSink{}
+	settings := openBotTeamRunner{post: post, model: "openai:gpt-6.2-sol", interval: time.Millisecond}
+	if err := settings.Run(context.Background(), "chat", cwd, "Analyze Q4.", sink); err != nil {
+		t.Fatal(err)
+	}
+	if len(actions) != 2 || len(sink.output) != 1 || sink.output[0] != "Revenue was 42.\n\nIt doubled over Q3.\n\n`"+filepath.ToSlash(artifact)+"`" {
+		t.Fatalf("actions %v, output %v", actions, sink.output)
+	}
+}
+
+func TestOpenBotTeamDoesNotDeliverAnotherRunsAnswer(t *testing.T) {
+	cwd := t.TempDir()
+	if err := os.WriteFile(filepath.Join(cwd, "answer.md"), []byte("previous answer"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, state := range []string{"done", "failed", "stopped"} {
+		t.Run(state, func(t *testing.T) {
+			sink := &openBotTestSink{}
+			r := &openBotTeamRunner{interval: time.Second, post: func(path string, body, result interface{}) error {
+				if path != "/api/workflow/run" {
+					t.Fatalf("unexpected request %s", path)
+				}
+				*result.(*workflowRunStatus) = workflowRunStatus{ID: "finished", State: state, Results: []string{"answer.md"}}
+				return nil
+			}}
+			if err := r.Run(context.Background(), "chat", cwd, "New prompt", sink); err == nil || len(sink.output) != 0 {
+				t.Fatalf("state %s: err %v, output %v", state, err, sink.output)
+			}
+		})
+	}
+}
+
+func TestOpenBotTeamDeliversWholeSupportedAnswers(t *testing.T) {
+	cwd := t.TempDir()
+	dir := filepath.Join(cwd, openBotReplyDir("test"))
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	reply := filepath.Join(dir, "answer.md")
+	for _, tc := range []struct {
+		name     string
+		answer   string
+		tooLarge bool
+	}{
+		{"25000 ASCII", strings.Repeat("x", 25_000), false},
+		{"32000 UTF-16 units with emoji and CJK", strings.Repeat("🌍界x", 8_000), false},
+		{"32001 for the workflow to check", strings.Repeat("界", 32_000) + "\n", false},
+		{"chat limit in UTF-8 bytes", strings.Repeat("界", 100_000), false},
+		{"chat limit in surrogate pairs", strings.Repeat("🌍", 50_000), false},
+		{"preserves indentation and final newlines", "  indented\r\n\r\n", false},
+		{"over chat limit in ASCII", strings.Repeat("x", 100_001), true},
+		{"over chat limit in surrogate pairs", strings.Repeat("🌍", 50_000) + "x", true},
+		{"over chat limit in UTF-8 bytes", strings.Repeat("界", 100_001), true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if err := os.WriteFile(reply, []byte(tc.answer), 0600); err != nil {
+				t.Fatal(err)
+			}
+			got, err := openBotTeamAnswer(cwd, "test")
+			if tc.tooLarge {
+				if got != "" || err == nil || !strings.Contains(err.Error(), "`"+filepath.ToSlash(reply)+"`") {
+					t.Fatalf("oversized answer returned %d bytes, err %v", len(got), err)
+				}
+				return
+			}
+			if err != nil || got != tc.answer {
+				t.Fatalf("expected complete %d-byte answer, got %d bytes, err %v", len(tc.answer), len(got), err)
