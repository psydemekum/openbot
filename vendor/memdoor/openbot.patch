+func TestOpenBotTeamRoleRetainsWorkflowPromptAndTreatsOverrideAsText(t *testing.T) {
+	role := &templates.YamlTaskDefinition{Type: "agent", Prompt: "Write report {{.Name}}.", Model: "old"}
+	command := &templates.YamlTaskDefinition{Type: "command", Prompt: "Unchanged"}
+	wf := workflow.Workflow{
+		Defs:  map[string]*templates.YamlTaskDefinition{"team-solve.steps.plan": role, "team-solve.steps.verify": command},
+		Tasks: []workflow.Task{{Full: "team-solve.steps.plan"}},
+	}
+	override := "{{ .Untrusted }} + quotes \"\nnext"
+	if err := applyOpenBotTeamRoles(&wf, map[string]openBotTeamRole{
+		"plan": {Model: "gpt-6.1-terra", Effort: "high", Prompt: override},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if role.Model != "openai:gpt-6.1-terra thinking high" || wf.Tasks[0].Model != role.Model || command.Prompt != "Unchanged" {
+		t.Fatalf("roles changed unexpectedly: %s, %v, %s", role.Model, wf.Tasks, command.Prompt)
+	}
+	tpl, err := template.New("prompt").Parse(role.Prompt)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var got bytes.Buffer
+	if err := tpl.Execute(&got, map[string]string{"Name": "A"}); err != nil {
+		t.Fatal(err)
+	}
+	if want := "Write report A.\n\nAdditional instructions from OpenBot:\n" + override; got.String() != want {
+		t.Fatalf("prompt was %q, want %q", got.String(), want)
+	}
+}
