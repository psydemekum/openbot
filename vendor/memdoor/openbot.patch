+func TestOpenBotTeamDeliversTheInPlaceRepairWithoutStaleArtifacts(t *testing.T) {
+	repo, err := filepath.Abs(filepath.Join("..", "..", ".."))
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, unborn := range []bool{false, true} {
+		t.Run(fmt.Sprintf("unborn=%t", unborn), func(t *testing.T) {
+			cwd := t.TempDir()
+			cmd := exec.Command("bash", "-ec", `
+				if [ "$2" = true ]; then git init -q; fi
+				w="$1/workflows/team-solve"; r=.memdoor/runs/team-solve-openbot-example
+				mkdir -p "$r/reply"; touch "$r/start"
+				echo original > before.txt
+				printf 'first answer\n<!-- openbot-artifacts: openbot-example\nbefore.txt\n-->\n' > "$r/reply/answer.md"
+				bash "$w/snapshot.sh" save "$r" a
+				bash "$w/snapshot.sh" reset "$r"
+				bash "$w/done.sh" direct "$r"
+				bash "$w/snapshot.sh" save "$r" direct
+				printf 'final repair without an attachment' > "$r/reply/answer.md"
+				bash "$w/done.sh" delivery "$r"
+			`, "test", filepath.ToSlash(repo), fmt.Sprint(unborn))
+			cmd.Dir = cwd
+			cmd.Env = append(os.Environ(), "MEMDOOR_OPENBOT_TEAM=1", "MEMDOOR_OPENBOT_STATE_DIR="+filepath.ToSlash(repo))
+			if out, err := cmd.CombinedOutput(); err != nil {
+				t.Fatalf("native workflow: %v\n%s", err, out)
+			}
+			text, err := openBotTeamAnswer(cwd, "openbot-example")
+			if err != nil || text != "final repair without an attachment" {
+				t.Fatalf("in-place result %q, err %v", text, err)
+			}
+		})
+	}
+}
