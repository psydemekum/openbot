+		bash "$1/snapshot.sh" restore "$r" b
+		grep -qx second "$r/reply/answer.md"
+		test "$(cat "$r/reply/answer.md")" = second
+		bash "$1/changes.sh" "$r"
+		grep -qx second "$r/changes.diff"
+		test -z "$(git status --porcelain)"
+	`, "test", filepath.ToSlash(wf))
+	cmd.Dir = t.TempDir()
+	cmd.Env = append(os.Environ(), "MEMDOOR_OPENBOT_TEAM=1")
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("snapshot: %v\n%s", err, out)
+	}
+}
