diff --git a/cmd/cli/cmd/acp_openbot_team.go b/cmd/cli/cmd/acp_openbot_team.go
new file mode 100644
index 0000000..ad754b9
--- /dev/null
+++ b/cmd/cli/cmd/acp_openbot_team.go
@@ -0,0 +1,366 @@
+package cmd
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf16"
+	"unicode/utf8"
+
+	"github.com/coder/acp-go-sdk"
+	"memdoor/gateway"
+)
+
+func serveOpenBotACP(ctx context.Context) error {
+	if !filepath.IsAbs(os.Getenv("MEMDOOR_OPENBOT_STATE_DIR")) {
+		return errors.New("OpenBot did not configure a Memdoor state directory")
+	}
+	// Model discovery only opens a session. Start the gateway when a real turn needs it.
+	out := os.Stdout
+	os.Stdout = os.Stderr
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	managed := &openBotGateway{ctx: ctx}
+	agent := newACPAgent(&openBotTeamRunner{
+		post: managed.post, model: "openai:" + os.Getenv("MEMDOOR_MODEL"), interval: time.Second,
+	})
+	agent.reportTurnError = true
+	conn := acp.NewAgentSideConnection(agent, out, os.Stdin)
+	agent.SetAgentConnection(conn)
+	<-conn.Done()
+	return nil
+}
+
+type openBotGateway struct {
+	ctx context.Context
+	mu  sync.Mutex
+	c   *Client
+}
+
+func (g *openBotGateway) post(path string, body interface{}, response interface{}) error {
+	c, err := g.client()
+	if err != nil {
+		return err
+	}
+	if fields, ok := body.(map[string]interface{}); ok && fields["workspace"] == "" {
+		fields["workspace"] = c.workspaceSlug
+	}
+	return c.PostJSON(path, body, response)
+}
+
+func (g *openBotGateway) client() (*Client, error) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	if g.c != nil {
+		return g.c, nil
+	}
+	if strings.TrimSpace(os.Getenv("OPENAI_API_KEY")) == "" {
+		return nil, errors.New("Set an OpenAI API key for the Memdoor team in OpenBot settings")
+	}
+	if strings.TrimSpace(os.Getenv("MEMDOOR_MODEL")) == "" {
+		return nil, errors.New("OpenBot did not configure a model for the Memdoor team")
+	}
+	if runtime.GOOS == "windows" {
+		for _, name := range []string{"git.exe", "sh.exe", "bash.exe"} {
+			if _, err := exec.LookPath(name); err != nil {
+				return nil, errors.New("Install Git for Windows with Git Bash to run the Memdoor team")
+			}
+		}
+	}
+	listener, err := net.Listen("tcp4", "127.0.0.1:0")
+	if err != nil {
+		return nil, err
+	}
+	gatewayAddr = "http://" + listener.Addr().String()
+	openBotGatewayToken = randomHex(32)
+	ctx, cancel := context.WithCancel(g.ctx)
+	ready := false
+	defer func() {
+		if !ready {
+			cancel()
+			_ = listener.Close()
+		}
+	}()
+	start := make(chan error, 1)
+	go func() { start <- gateway.StartOnListener(ctx, listener, openBotGatewayToken) }()
+	ticker := time.NewTicker(100 * time.Millisecond)
+	defer ticker.Stop()
+	deadline := time.NewTimer(20 * time.Second)
+	defer deadline.Stop()
+	for !gatewayReachable() {
+		select {
+		case err := <-start:
+			return nil, fmt.Errorf("Memdoor gateway did not start: %w", err)
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-deadline.C:
+			return nil, errors.New("Memdoor gateway did not become ready")
+		case <-ticker.C:
+		}
+	}
+	if err := machineReady(); err != nil {
+		return nil, err
+	}
+	c := NewClient()
+	c.workspaceSlug = ownWorkspace(c, workspaceSlug)
+	c.HTTPClient.Timeout = 15 * time.Second
+	g.c = c
+	ready = true
+	return c, nil
+}
+
+// The editor stays in its ACP turn until the actual team run ends.
+type openBotTeamRunner struct {
+	post      func(string, interface{}, interface{}) error
+	workspace string
+	model     string
+	interval  time.Duration
+}
+
+func (*openBotTeamRunner) NewConversation(context.Context, string) (string, error) {
+	return randomHex(16), nil
+}
+
+func (*openBotTeamRunner) SetModel(context.Context, string, string) error { return nil }
+
+// The cancelled Run owns stopping its own job, including cancellation while it is starting.
+func (*openBotTeamRunner) Interrupt(context.Context, string) error { return nil }
+
+func (r *openBotTeamRunner) Run(ctx context.Context, _ string, cwd, text string, sink turnSink) (err error) {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	partition := "openbot-" + randomHex(16)
+	var status workflowRunStatus
+	err = r.post("/api/workflow/run", map[string]interface{}{
+		"name": "team-solve", "dir": cwd, "workspace": r.workspace, "model": r.model,
+		"partition": partition, "prompt": openBotDeliveryPrompt(text, partition), "require_model": true,
+	}, &status)
+	if err != nil {
+		return err
+	}
+	if status.ID == "" {
+		return errors.New("Memdoor did not return a team run id")
+	}
+	id := status.ID
+	request := map[string]interface{}{"run_id": id, "workspace": r.workspace}
+	tool := "memdoor-team-" + id
+	sink.ToolStart(tool, "Memdoor team", nil)
+	terminal := false
+	defer func() {
+		if !terminal {
+			err = errors.Join(err, r.post("/api/workflow/stop", request, nil))
+		}
+		if err != nil {
+			sink.ToolDone(tool, err.Error(), true)
+		}
+	}()
+	poll := time.NewTicker(r.interval)
+	defer poll.Stop()
+	lastGate := ""
+	lastDone := -1
+	for {
+		if progress, ok := sink.(interface{ ToolProgress(string, string) }); ok && status.Total > 0 && status.Done != lastDone {
+			progress.ToolProgress(tool, fmt.Sprintf("Memdoor team · %d/%d steps", status.Done, status.Total))
+			lastDone = status.Done
+		}
+		switch status.State {
+		case "done":
+			terminal = true
+			if err := ctx.Err(); err != nil {
+				return err
+			}
+			answer, err := openBotTeamAnswer(cwd, partition)
+			if err != nil {
+				return err
+			}
+			sink.ToolDone(tool, fmt.Sprintf("%d/%d steps complete.", status.Done, status.Total), false)
+			sink.Text(answer)
+			return nil
+		case "failed", "stopped":
+			terminal = true
+			if status.Error == "" {
+				return fmt.Errorf("Memdoor team %s", status.State)
+			}
+			return fmt.Errorf("Memdoor team %s: %s", status.State, status.Error)
+		case "waiting":
+			if gate := waitingGate(status); gate != "" && gate != lastGate {
+				if sink.Ask("Approve Memdoor team step "+gate+"?", []string{"Yes", "No"}, "workflow") != "Yes" {
+					return errors.New("Memdoor team approval declined")
+				}
+				if err := r.post("/api/workflow/approve", map[string]interface{}{
+					"run_id": id, "workspace": r.workspace, "task": gate,
+				}, nil); err != nil {
+					return err
+				}
+				lastGate = gate
+			}
+		default:
+			lastGate = ""
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-poll.C:
+		}
+		if err := r.post("/api/workflow/status", request, &status); err != nil {
+			return err
+		}
+		if status.ID != id {
+			return errors.New("Memdoor returned a different team run")
+		}
+	}
+}
+
+// The native workflow snapshots the reply with each attempt.
+func openBotReplyDir(partition string) string {
+	return filepath.Join(".memdoor", "runs", "team-solve-"+partition, "reply")
+}
+
+func openBotDeliveryPrompt(prompt, partition string) string {
+	dir := filepath.ToSlash(openBotReplyDir(partition))
+	return prompt + "\n\nOpenBot delivery for this run (include it in the deliverable, scope and checks):\n" +
+		"Write the complete final reply for the user to " + dir + "/answer.md in the project. " +
+		"For a text-only request this reply is the sole deliverable. Put the actual answer there in the requested language and format. " +
+		"For project work, do the work and describe the verified result there. " +
+		"Each time you write the reply, replace the whole file. Keep workflow notes and verdicts out of it. " +
+		"When the user wants files, append this Markdown comment at the end, replacing the example with the finished project-relative paths, one per line. " +
+		"OpenBot removes this comment and links the files. For a text-only answer omit the comment.\n" +
+		openBotArtifactHeader(partition) + "\npath/to/finished-file.pdf\n-->"
+}
+
+func openBotArtifactHeader(partition string) string { return "<!-- openbot-artifacts: " + partition }
+
+// OpenBot INPUT_LIMITS.messageText counts JavaScript UTF-16 code units.
+// One unit can take at most three UTF-8 bytes. A supplementary character
+// takes four bytes but uses two units.
+const openBotAnswerUnits = 100_000
+const openBotAnswerBytes = 3 * openBotAnswerUnits
+const openBotManifestBytes = 8192
+
+func openBotTeamAnswer(cwd, partition string) (string, error) {
+	root, err := os.OpenRoot(cwd)
+	if err != nil {
+		return "", err
+	}
+	defer root.Close()
+	dir := openBotReplyDir(partition)
+	reply := filepath.Join(dir, "answer.md")
+	header := openBotArtifactHeader(partition)
+	// Allow the complete body plus its removable CRLF-delimited artifact comment.
+	readLimit := int64(openBotAnswerBytes + openBotManifestBytes + len(header) + 16)
+	data, err := readOpenBotResult(root, reply, readLimit+1)
+	if err != nil {
+		return "", fmt.Errorf("Memdoor could not deliver this run's answer: %w", err)
+	}
+	tooLarge := func() error {
+		return fmt.Errorf("Memdoor's reply exceeds OpenBot's %d UTF-16 code unit chat limit. The complete answer is in `%s`", openBotAnswerUnits, filepath.ToSlash(filepath.Join(cwd, reply)))
+	}
+	if int64(len(data)) > readLimit {
+		return "", tooLarge()
+	}
+	if !utf8.Valid(data) || strings.ContainsRune(string(data), '\x00') {
+		return "", errors.New("Memdoor produced an invalid text answer")
+	}
+	answer := string(data)
+	var manifest string
+	// Keep the body byte-for-byte. Only the exact marker for this run can
+	// introduce metadata, so examples of HTML comments stay ordinary text.
+	if before, block, ok := strings.Cut("\n"+answer, "\n"+header); ok {
+		answer = strings.TrimSuffix(strings.TrimPrefix(before, "\n"), "\r")
+		block = strings.TrimPrefix(block, "\r")
+		lines, opened := strings.CutPrefix(block, "\n")
+		files, closed := strings.CutSuffix(strings.TrimRight(lines, "\r\n"), "\n-->")
+		if !opened || !closed || len(files) > openBotManifestBytes {
+			return "", errors.New("Memdoor produced an invalid artifact list in its answer")
+		}
+		manifest = files
+	}
+	if strings.TrimSpace(answer) == "" && strings.TrimSpace(manifest) == "" {
+		return "", errors.New("Memdoor produced an empty answer")
+	}
+	var result strings.Builder
+	result.WriteString(answer)
+	separator := "\n\n"
+	if answer == "" {
+		separator = ""
+	} else if strings.HasSuffix(answer, "\n") {
+		separator = "\n"
+	}
+	seen := make(map[string]bool)
+	for _, entry := range strings.Split(strings.TrimSpace(manifest), "\n") {
+		name := filepath.FromSlash(strings.TrimSpace(entry))
+		if name == "" || seen[name] {
+			continue
+		}
+		if !filepath.IsLocal(name) || strings.ContainsAny(name, "`\x00\r") || filepath.Clean(name) != name {
+			return "", fmt.Errorf("Memdoor returned an invalid project artifact path %q", name)
+		}
+		for _, part := range strings.Split(filepath.ToSlash(name), "/") {
+			if strings.EqualFold(part, ".memdoor") || strings.EqualFold(part, ".git") {
+				return "", fmt.Errorf("Memdoor returned an internal file as an artifact: %s", name)
+			}
+		}
+		if err := checkOpenBotFile(root, name); err != nil {
+			return "", fmt.Errorf("Memdoor could not deliver the artifact %q: %w", name, err)
+		}
+		seen[name] = true
+		// OpenBot attaches up to ten absolute paths. Its chat also opens
+		// workspace-relative references, including any further files.
+		if len(seen) <= 10 {
+			name = filepath.Join(cwd, name)
+		}
+		result.WriteString(separator + "`" + filepath.ToSlash(name) + "`")
+		separator = "\n\n"
+	}
+	units := 0
+	for _, char := range result.String() {
+		units += utf16.RuneLen(char)
+		if units > openBotAnswerUnits {
+			return "", tooLarge()
+		}
+	}
+	return result.String(), nil
+}
+
+func readOpenBotResult(root *os.Root, path string, limit int64) ([]byte, error) {
+	if err := checkOpenBotFile(root, path); err != nil {
+		return nil, err
+	}
+	file, err := root.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+	return io.ReadAll(io.LimitReader(file, limit))
+}
+
+// Keep result files inside this project and reject links to another run.
+func checkOpenBotFile(root *os.Root, path string) error {
+	for parent := filepath.Dir(path); parent != "."; parent = filepath.Dir(parent) {
+		info, err := root.Lstat(parent)
+		if err != nil {
+			return err
+		}
+		if !info.IsDir() {
+			return fmt.Errorf("invalid result directory %q", parent)
+		}
+	}
+	info, err := root.Lstat(path)
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("invalid result file %q", path)
+	}
+	return nil
+}
