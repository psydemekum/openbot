+func TestOpenBotTeamCancelsOnlyItsRun(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	stopped := false
+	post := func(path string, body interface{}, result interface{}) error {
+		req := body.(map[string]interface{})
+		switch path {
+		case "/api/workflow/run":
+			*result.(*workflowRunStatus) = workflowRunStatus{ID: "team-2", State: "running"}
+			cancel()
+		case "/api/workflow/stop":
+			stopped = req["run_id"] == "team-2"
+		}
+		return nil
+	}
+	settings := openBotTeamRunner{post: post, model: "openai:gpt-6.2-sol", interval: time.Hour}
+	if err := settings.Run(ctx, "chat", t.TempDir(), "Check the code.", &openBotTestSink{}); !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancel returned %v", err)
+	}
+	if !stopped {
+		t.Fatal("did not stop the team job")
+	}
+}
