--- /dev/null
+++ b/gateway/openbot_team_settings.go
@@ -0,0 +1,92 @@
+package gateway
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"memdoor/pkg/workflow"
+)
+
+type openBotTeamRole struct {
+	Model  string `json:"model"`
+	Effort string `json:"effort"`
+	Prompt string `json:"prompt"`
+}
+
+type openBotTeamConfig struct {
+	Version       int                        `json:"version"`
+	TeamModel     string                     `json:"teamModel"`
+	DecisionModel string                     `json:"decisionModel"`
+	Roles         map[string]openBotTeamRole `json:"roles"`
+}
+
+var openBotModelID = regexp.MustCompile(`^gpt-[a-z0-9][a-z0-9.-]{0,79}$`)
+
+func loadOpenBotTeamRoles(wf *workflow.Workflow) error {
+	path := os.Getenv("MEMDOOR_OPENBOT_ROLES_FILE")
+	if path == "" {
+		return nil
+	}
+	file, err := os.Open(path)
+	if os.IsNotExist(err) {
+		return nil
+	}
+	if err != nil {
+		return fmt.Errorf("Memdoor could not open the OpenBot role settings")
+	}
+	defer file.Close()
+	var config openBotTeamConfig
+	decoder := json.NewDecoder(io.LimitReader(file, 512*1024))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&config); err != nil || config.Version != 1 {
+		return fmt.Errorf("Invalid OpenBot role settings")
+	}
+	if decoder.Decode(&struct{}{}) != io.EOF {
+		return fmt.Errorf("Invalid trailing data in OpenBot role settings")
+	}
+	return applyOpenBotTeamRoles(wf, config.Roles)
+}
+
+func applyOpenBotTeamRoles(wf *workflow.Workflow, roles map[string]openBotTeamRole) error {
+	for i := range wf.Tasks {
+		task := &wf.Tasks[i]
+		def := wf.Defs[task.Full]
+		if def == nil || (def.Type != "agent" && def.Type != "llm") {
+			continue
+		}
+		name := task.Full[strings.LastIndex(task.Full, ".")+1:]
+		role, ok := roles[name]
+		if !ok {
+			continue
+		}
+		model := role.Model
+		if model == "" {
+			model = os.Getenv("MEMDOOR_MODEL")
+		}
+		if !openBotModelID.MatchString(model) {
+			return fmt.Errorf("Invalid OpenAI model for Memdoor role %s", name)
+		}
+		def.Model = "openai:" + model
+		switch role.Effort {
+		case "":
+		case "none", "low", "medium", "high", "xhigh", "max":
+			def.Model += " thinking " + role.Effort
+		default:
+			return fmt.Errorf("Invalid reasoning effort for Memdoor role %s", name)
+		}
+		if len(role.Prompt) > 32000 {
+			return fmt.Errorf("The prompt for Memdoor role %s is too long", name)
+		}
+		if role.Prompt != "" {
+			// Keep the supplied text out of the workflow's template syntax.
+			def.Prompt += "\n\nAdditional instructions from OpenBot:\n{{printf \"%s\" " + strconv.Quote(role.Prompt) + "}}"
+		}
+		task.Model, task.Prompt = def.Model, def.Prompt
+	}
+	return nil
+}
