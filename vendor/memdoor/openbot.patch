+func TestOpenBotTeamSnapshotsTheReplyWithTheAttempt(t *testing.T) {
+	wf, err := filepath.Abs("team-solve")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command("bash", "-ec", `
+		r=.memdoor/runs/team-solve-openbot-fixture
+		mkdir -p "$r/reply"
+		git init -q
+		printf '.memdoor/\n' > .gitignore
+		echo 'stale root answer' > answer.md
+		git add answer.md .gitignore
+		git -c user.name=t -c user.email=t@t commit -qm baseline
+		git rev-parse HEAD > "$r/base.txt"
+		touch "$r/start" "$r/untracked-before.txt"
+		if bash "$1/done.sh" delivery "$r"; then exit 1; fi
+		printf 'first\n<!-- openbot-artifacts: openbot-fixture\nanswer.md\n-->\n' > "$r/reply/answer.md"
+		bash "$1/done.sh" delivery "$r"
+		bash "$1/snapshot.sh" save "$r" a
+		bash "$1/snapshot.sh" reset "$r"
+		test ! -e "$r/reply/answer.md"
+		echo second > "$r/reply/answer.md"
+		bash "$1/snapshot.sh" save "$r" b
+		bash "$1/snapshot.sh" restore "$r" a
+		grep -qx first "$r/reply/answer.md"
+		grep -qx answer.md "$r/reply/answer.md"
+		bash "$1/snapshot.sh" restore "$r" b
+		grep -qx second "$r/reply/answer.md"
+		test "$(cat "$r/reply/answer.md")" = second
+		bash "$1/changes.sh" "$r"
+		grep -qx second "$r/changes.diff"
+		test -z "$(git status --porcelain)"
+	`, "test", filepath.ToSlash(wf))
+	cmd.Dir = t.TempDir()
+	cmd.Env = append(os.Environ(), "MEMDOOR_OPENBOT_TEAM=1")
+	if out, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("snapshot: %v\n%s", err, out)
+	}
+}
