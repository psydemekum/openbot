+				t.Fatalf("answer %q, error %v", answer, err)
+			}
+			body := <-bodies
+			if body.Model != "gpt-6-sol" || body.Reasoning["effort"] != effort || (effort == "") != (body.Reasoning == nil) {
+				t.Fatalf("Responses body: %+v", body)
+			}
+			sampling := effort == "" || effort == "none"
+			if (body.Temperature != nil) != sampling || (body.TopP != nil) != sampling {
+				t.Fatalf("sampling parameters for %q: %+v", effort, body)
+			}
+		})
+	}
+}
