+var openBotConnections atomic.Pointer[map[string]openBotConnection]
+
+var (
+	openBotGPT        = regexp.MustCompile(`^gpt-[a-z0-9][a-z0-9.-]{0,79}$`)
+	openBotProviderID = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]*$`)
+	openBotWireModel  = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:/\[\],=-]{0,159}$`)
+)
+
+// LoadOpenBotProviders takes the host's selected connections into memory
+// before a managed ACP turn can start a project command.
+func LoadOpenBotProviders() error {
+	raw := os.Getenv(openBotProvidersEnv)
+	if err := os.Unsetenv(openBotProvidersEnv); err != nil {
+		return errors.New("could not remove OpenBot provider credentials from the environment")
+	}
+	openBotConnections.Store(nil)
+	if raw == "" {
+		return nil
+	}
+	var connections map[string]openBotConnection
+	if err := json.Unmarshal([]byte(raw), &connections); err != nil || connections == nil {
+		return errors.New("invalid OpenBot provider connections")
+	}
+	for pin, connection := range connections {
+		provider, _, ok := splitOpenBotPin(pin)
+		if !ok || provider == VendorOpenAI || !connection.valid() {
+			return errors.New("invalid OpenBot provider connection")
+		}
+	}
+	openBotConnections.Store(&connections)
+	return nil
+}
+
+func (c openBotConnection) valid() bool {
+	if c.Model == "" || len(c.Model) > 1024 || strings.TrimSpace(c.Model) != c.Model ||
+		strings.ContainsFunc(c.Model, unicode.IsControl) || c.Context < 0 ||
+		(c.Key != "" && !httpguts.ValidHeaderFieldValue(c.Key)) {
+		return false
+	}
+	switch c.API {
+	case APIAnthropic, APIResponses, APIChat, APIOpenRouter:
+	default:
+		return false
+	}
+	u, err := url.Parse(c.Base)
+	if err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Hostname() == "" ||
+		u.User != nil || u.Opaque != "" || u.RawQuery != "" || u.ForceQuery || u.Fragment != "" {
+		return false
+	}
+	for name, value := range c.Headers {
+		if !httpguts.ValidHeaderFieldName(name) || !httpguts.ValidHeaderFieldValue(value) {
+			return false
+		}
+		switch http.CanonicalHeaderKey(name) {
+		case "Host", "Content-Length", "Transfer-Encoding", "Connection", "Trailer", "Upgrade", "Proxy-Authorization", "Proxy-Connection":
+			return false
+		}
+	}
+	return true
+}
+
+func splitOpenBotPin(pin string) (provider, model string, ok bool) {
+	provider, model, ok = strings.Cut(pin, ":")
+	return provider, model, ok && openBotProviderID.MatchString(provider) && openBotWireModel.MatchString(model)
+}
+
+// OpenBotModelPin converts a legacy GPT model to its provider-qualified pin
+// and verifies that a selected connection exists for any other model.
+func OpenBotModelPin(pin string) (string, error) {
+	if openBotGPT.MatchString(pin) {
+		return VendorOpenAI + ":" + pin, nil
+	}
+	provider, model, ok := splitOpenBotPin(pin)
+	if !ok || (provider == VendorOpenAI && !openBotGPT.MatchString(model)) {
+		return "", errors.New("invalid OpenBot model pin")
+	}
+	if provider != VendorOpenAI {
+		if _, ok := openBotConnectionFor(pin); !ok {
+			return "", fmt.Errorf("no OpenBot provider connection configured for %s", pin)
+		}
+	}
+	return pin, nil
+}
+
+func openBotConnectionFor(pin string) (openBotConnection, bool) {
+	if connections := openBotConnections.Load(); connections != nil {
+		c, ok := (*connections)[pin]
+		return c, ok
+	}
+	return openBotConnection{}, false
+}
+
+// openBotClient uses the exact pin, including the provider's identity
+// when different connections offer a model with the same ID.
+func openBotClient(ctx context.Context) (LLMClient, error) {
+	key := strings.TrimSpace(os.Getenv("OPENAI_API_KEY"))
+	if key == "" {
+		return nil, errors.New("set an OpenAI API key for the Memdoor team in OpenBot settings")
+	}
+	pin := ModelFromContext(ctx)
+	if pin == "" {
+		pin = os.Getenv("MEMDOOR_MODEL")
+	}
+	pin, err := OpenBotModelPin(pin)
+	if err != nil {
+		return nil, err
+	}
+	provider, model, _ := splitOpenBotPin(pin)
+	if provider == VendorOpenAI {
+		client := newResponsesClient(key, openaiDefaultBase, model).(*responsesClient)
+		client.openBotEffort = true
+		(openBotConnection{Key: key}).configureHTTP(client.httpClient)
+		return client, nil
+	}
+	connection, _ := openBotConnectionFor(pin)
+	return connection.client(ctx), nil
+}
+
+func (c openBotConnection) client(ctx context.Context) LLMClient {
+	base := strings.TrimRight(c.Base, "/")
+	var client LLMClient
+	switch c.API {
+	case APIAnthropic:
+		// Anthropic's adapter adds /v1/messages itself.
+		base = strings.TrimSuffix(strings.TrimSuffix(base, "/v1/messages"), "/v1")
+		client = newAnthropicClient(c.Key, base, c.Model)
+		anthropic := client.(*anthropicClient)
+		c.configureHTTP(anthropic.httpClient)
+	case APIResponses:
+		client = newResponsesClient(c.Key, base, c.Model)
+		responses := client.(*responsesClient)
+		c.configureHTTP(responses.httpClient)
+	default:
+		p := Provider{API: c.API, Base: base, Key: c.Key, Keyless: c.Key == ""}
+		chat := p.Client(ctx, c.Model).(*oaiClient)
+		chat.openBot = true
+		c.configureHTTP(chat.httpClient)
+		client = chat
+	}
+	return client
+}
+
+func (c openBotConnection) configureHTTP(client *http.Client) {
+	var redactions []string
+	addSecret := func(secret string) {
+		if secret != "" {
+			escaped, _ := json.Marshal(secret)
+			redactions = append(redactions, string(escaped[1:len(escaped)-1]), "[redacted]", secret, "[redacted]")
+		}
+	}
+	addSecret(c.Key)
+	for name, value := range c.Headers {
+		addSecret(value)
+		if http.CanonicalHeaderKey(name) == "Authorization" {
+			_, credential, _ := strings.Cut(value, " ")
+			addSecret(credential)
+		}
+	}
+	client.Transport = openBotTransport{next: client.Transport, headers: c.Headers, redactions: strings.NewReplacer(redactions...)}
+	client.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
+}
+
+type openBotTransport struct {
+	next       http.RoundTripper
+	headers    map[string]string
+	redactions *strings.Replacer
+}
+
+func (t openBotTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	req = req.Clone(req.Context())
+	for name, value := range t.headers {
+		req.Header.Set(name, value)
+	}
+	resp, err := t.next.RoundTrip(req)
+	if err == nil && resp.StatusCode != http.StatusOK {
+		// Keep provider error details (such as a context-length rejection)
+		// available to the adapter while removing any echoed credentials.
+		const maxErrorBody = 1 << 20
+		body, readErr := io.ReadAll(io.LimitReader(resp.Body, maxErrorBody+1))
+		resp.Body.Close()
+		resp.Body = http.NoBody
+		resp.ContentLength = 0
+		if readErr == nil && len(body) <= maxErrorBody {
+			body = []byte(t.redactions.Replace(string(body)))
+			resp.Body = io.NopCloser(bytes.NewReader(body))
+			resp.ContentLength = int64(len(body))
+		}
+	}
+	return resp, err
+}
+
+func findOpenBotModel(pin string) (Provider, Model, bool) {
+	if pin == "" {
+		pin = os.Getenv("MEMDOOR_MODEL")
+	}
+	pin, err := OpenBotModelPin(pin)
+	if err != nil {
+		return Provider{}, Model{}, false
+	}
+	provider, id, _ := splitOpenBotPin(pin)
+	api, window, source := APIResponses, openaiDefaultContext, ContextDefault
+	if provider != VendorOpenAI {
+		connection, _ := openBotConnectionFor(pin)
+		api, id, window = connection.API, connection.Model, connection.Context
+		switch {
+		case window > 0:
+			source = ContextDeclared
+		case api == APIAnthropic:
+			window = anthropicDefaultContext
+		default:
+			window = gatewayDefaultContext
+		}
+	}
+	// Return metadata only. The factory owns the in-memory credentials.
+	return Provider{ID: provider, API: api}, Model{ID: id, Context: window, ContextSource: source}, true
+}
